---
const { id, lessonIds = [] } = Astro.props;
---
<section class="card record-box simple-progress-box" id="practice-record" data-article-id={id} data-lesson-ids={JSON.stringify(lessonIds)}>
  <div class="progress-head">
    <div>
      <h2>学习记录</h2>
      <p class="subtle small">点击下方按钮标记本节学习进度，将自动保存到本地 SQLite 数据库。</p>
    </div>
    <span class="progress-state-pill is-unlearned" id="record-pill">✕ 未学习</span>
  </div>
  <div class="progress-toggle-row" role="group" aria-label="标记学习状态">
    <button type="button" class="progress-choice-btn is-learn" id="mark-learned" aria-pressed="false">
      <span class="progress-icon" aria-hidden="true">✓</span>
      <span>已学习</span>
    </button>
    <button type="button" class="progress-choice-btn is-unlearn is-selected" id="mark-unlearned" aria-pressed="true">
      <span class="progress-icon" aria-hidden="true">✕</span>
      <span>未学习</span>
    </button>
  </div>
  <p class="form-status" id="record-status" role="status">当前状态：未学习{lessonIds.length > 1 ? `（本页包含 ${lessonIds.length} 个小节，也可在左侧目录单独点击每小节的 ✓ / ✕）` : ''}</p>
</section>
<script>
import { state, setStudyProgress } from '../scripts/browser-state.mjs';

const box = document.querySelector('#practice-record');
if (box) {
  const articleId = box.dataset.articleId || '';
  const lessonIds = JSON.parse(box.dataset.lessonIds || '[]');
  const btnLearned = document.querySelector('#mark-learned');
  const btnUnlearned = document.querySelector('#mark-unlearned');
  const pill = document.querySelector('#record-pill');
  const statusEl = document.querySelector('#record-status');

  function isArticleLearned(data) {
    if (lessonIds.length > 0) {
      return lessonIds.every(lid => data.lessonProgress?.[lid]?.learned === true);
    }
    return data.records?.[articleId]?.status === 'passed';
  }

  function countLearnedOnPage(data) {
    return lessonIds.filter(lid => data.lessonProgress?.[lid]?.learned === true).length;
  }

  function renderBox(data, syncedHint = '') {
    const allLearned = isArticleLearned(data);
    const doneCount = countLearnedOnPage(data);
    btnLearned.classList.toggle('is-selected', allLearned);
    btnLearned.setAttribute('aria-pressed', String(allLearned));
    btnUnlearned.classList.toggle('is-selected', !allLearned);
    btnUnlearned.setAttribute('aria-pressed', String(!allLearned));

    pill.classList.toggle('is-learned', allLearned);
    pill.classList.toggle('is-unlearned', !allLearned);
    if (allLearned) {
      pill.textContent = '✓ 已学习';
    } else if (lessonIds.length > 1 && doneCount > 0) {
      pill.textContent = `已学 ${doneCount}/${lessonIds.length}`;
    } else {
      pill.textContent = '✕ 未学习';
    }

    if (syncedHint) {
      statusEl.textContent = syncedHint;
      return;
    }
    const latestDate = lessonIds.map(lid => data.lessonProgress?.[lid]?.studyDate).filter(Boolean).sort().at(-1)
      || (data.records?.[articleId]?.updatedAt ? data.records[articleId].updatedAt.slice(0, 10) : '');
    if (allLearned) {
      statusEl.textContent = `当前状态：✓ 已学习${latestDate ? `（学习日期：${latestDate}）` : ''}`;
    } else if (lessonIds.length > 1 && doneCount > 0) {
      statusEl.textContent = `当前进度：已完成本页 ${doneCount} / ${lessonIds.length} 个小节（点击「已学习」可一键全部打钩）`;
    } else {
      statusEl.textContent = '当前状态：✕ 未学习';
    }
  }

  renderBox(state());
  window.addEventListener('study-state:change', event => {
    if (event.detail?.state) renderBox(event.detail.state);
  });

  async function handleMark(learned) {
    btnLearned.disabled = true;
    btnUnlearned.disabled = true;
    const result = await setStudyProgress({ lessonIds, articleId, learned });
    btnLearned.disabled = false;
    btnUnlearned.disabled = false;
    if (!result.ok || !result.state) return;
    const dbText = result.syncedDb ? '已持久化到 SQLite 数据库' : '已保存到本地存储';
    renderBox(result.state, learned ? `✓ 已标记为「已学习」· ${dbText}` : `✕ 已标记为「未学习」· ${dbText}`);
  }

  btnLearned.addEventListener('click', () => handleMark(true));
  btnUnlearned.addEventListener('click', () => handleMark(false));
}
</script>
