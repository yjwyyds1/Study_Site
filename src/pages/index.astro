---
import Shell from '../layouts/Shell.astro';
import { href, itemList } from '../lib/catalog.mjs';
import { fullCurriculum } from '../lib/full-curriculum.mjs';

const unit = itemList().filter(item => item.trackable);
const totalLessons = fullCurriculum.reduce(
  (sum, subject) => sum + subject.parts.reduce((ps, p) => ps + p.modules.reduce((ms, m) => ms + m.lessons.length, 0), 0),
  0
);
const lessonMeta = fullCurriculum.flatMap(subject =>
  subject.parts.flatMap(part =>
    part.modules.flatMap(mod =>
      mod.lessons.map(lesson => ({
        id: lesson.id,
        title: `${lesson.id} ${lesson.title}`,
        url: href((lesson.readings[0]?.ref ?? 'handbook/cpp-setup') + '/'),
        articleId: lesson.readings[0]?.ref ?? ''
      }))
    )
  )
);
const first = href('handbook/cpp-setup/');
const storageDescription = import.meta.env.PUBLIC_STUDY_STATIC === 'true'
  ? '学习进度保存在当前浏览器，可导出备份。'
  : '学习进度保存在浏览器，并同步至本地 SQLite 数据库。';
---
<Shell title="开始学习" section="home">
<div class="page home" id="study-home" data-unit={JSON.stringify(unit)} data-lessons={JSON.stringify(lessonMeta)}>
  <header class="page-head home-head">
    <h1>开始学习</h1>
    <p class="lead">10 大学科、{totalLessons} 个零基础到工程实战小节；点顶部学科即可直达每门课第 0 课。{storageDescription}</p>
    <div class="home-links">
      <a class="button primary" id="continue-link" href={first}><span>开始第一课</span></a>
      <a class="button" href={href('roadmap/')}>跨学科路线图</a>
      <a class="button" href={href('labs/')}>项目实验（LogScan v0~v3）</a>
      <a class="button" href={href('notes/')}>笔记与博客</a>
      <a class="button" href={href('records/')}>查看学习进度仪表盘</a>
    </div>
  </header>

  <section class="home-section">
    <div class="section-head"><h2>现在做什么</h2><span class="subtle small" id="evidence-count">0 / {totalLessons} 已学习</span></div>
    <p id="next-description">零基础入门？从<a href={href('handbook/cpp-setup/')}>第 0 课：在 Windows 上搭好 C++20 环境</a>开始，或直接从顶部选择想学的学科大类。</p>
    <p>已有 C++ 语法基础？直接进入<a href={href('handbook/toolchain/')}>编译、链接与调试</a>，或挑战 <a href={href('labs/logscan/')}>LogScan v0 实验</a>。</p>
    <p class="subtle small" id="today-summary"></p>
  </section>

  <details class="home-section study-focus" id="weekly-plan" hidden>
    <summary>我的本周任务</summary>
    <p id="focus-text"></p>
    <a class="small" href={href('records/#profile')}>调整学习计划</a>
  </details>
</div>
</Shell>
<script>
import { state } from '../scripts/browser-state.mjs';
import { localDateKey } from '../lib/state.mjs';

const root = document.querySelector('#study-home');
const unit = JSON.parse(root.dataset.unit);
const lessons = JSON.parse(root.dataset.lessons);

function renderHome(data) {
  const progress = data.lessonProgress || {};
  const records = data.records || {};
  const isLearned = l => progress[l.id] !== undefined ? progress[l.id].learned === true : records[l.articleId]?.status === 'passed';

  const current = unit.find(x => x.id === data.current?.id);
  const next = lessons.find(l => !isLearned(l));
  if (current) {
    const link = document.querySelector('#continue-link');
    link.href = current.url + (data.current.anchor ? '#' + encodeURIComponent(data.current.anchor) : '');
    link.querySelector('span').textContent = '继续上次学习';
    link.title = current.title;
    const output = document.querySelector('#next-description');
    if (next) {
      const nextLink = Object.assign(document.createElement('a'), { href: next.url, textContent: next.title });
      output.replaceChildren('下一节未学：', nextLink);
    } else {
      const reviewLink = Object.assign(document.createElement('a'), { href: new URL('records/', location.href).href, textContent: '查看完整学习成就面板' });
      output.replaceChildren('全部小节已打钩完成，去', reviewLink, '。');
    }
  }

  const learnedCount = lessons.filter(isLearned).length;
  const today = localDateKey();
  const todayCount = data.dailyLog?.[today] || lessons.filter(l => progress[l.id]?.learned && progress[l.id]?.studyDate === today).length;
  document.querySelector('#evidence-count').textContent = `${learnedCount} / ${lessons.length} 已学习`;
  const todayEl = document.querySelector('#today-summary');
  todayEl.textContent = todayCount > 0 ? `今日（${today}）已学完 ${todayCount} 节 · 点击左侧目录 ✓/✕ 可随时标记单节状态。` : `今日暂未打卡学习 · 打开任意章节底部点击「✓ 已学习」即可计入今日进度。`;

  if (data.profile.weeklyFocus?.trim()) {
    document.querySelector('#focus-text').textContent = data.profile.weeklyFocus;
    document.querySelector('#weekly-plan').hidden = false;
  }
}

renderHome(state());
window.addEventListener('study-state:change', event => {
  if (event.detail?.state) renderHome(event.detail.state);
});
</script>
