---
import Shell from '../layouts/Shell.astro';
import { href, itemList } from '../lib/catalog.mjs';
const unit = itemList().filter(item => item.trackable);
const first = href('handbook/cpp-setup/');
---
<Shell title="开始学习" section="home">
<div class="page home" id="study-home" data-unit={JSON.stringify(unit)}>
  <header class="page-head home-head">
    <h1>开始学习</h1>
    <p class="lead">先练熟 C++ 基础手感，再学工程工具与核心机制，把知识做成可测试的项目。</p>
    <div class="home-links">
      <a class="button primary" id="continue-link" href={first}><span>开始第一课</span></a>
    </div>
  </header>

  <section class="home-section">
    <div class="section-head"><h2>现在做什么</h2><span class="subtle small" id="evidence-count">0 / {unit.length} 通过验收</span></div>
    <p id="next-description">零基础入门？从<a href={href('handbook/cpp-setup/')}>第 0 课：在 Windows 上搭好 C++20 环境</a>开始，前 6 课只写单文件小程序。</p>
    <p>已有 C++ 语法基础？直接进入<a href={href('handbook/toolchain/')}>第 1 阶段：编译、链接与调试</a>，或挑战 <a href={href('labs/logscan/')}>LogScan v0 实验</a>。</p>
    <p class="subtle small" id="review-queue" hidden></p>
  </section>

  <details class="home-section study-focus" id="weekly-plan" hidden>
    <summary>我的本周任务</summary>
    <p id="focus-text"></p>
    <a class="small" href={href('records/#profile')}>调整学习计划</a>
  </details>
</div>
</Shell>
<script>
import { state } from '../scripts/browser-state.mjs';
const root = document.querySelector('#study-home');
const unit = JSON.parse(root.dataset.unit);
const data = state();
const current = unit.find(x => x.id === data.current?.id);
const next = unit.find(x => data.records[x.id]?.status !== 'passed');
if (current) {
  const link = document.querySelector('#continue-link');
  link.href = current.url + (data.current.anchor ? '#' + encodeURIComponent(data.current.anchor) : '');
  link.querySelector('span').textContent = '继续上次学习';
  link.title = current.title;
  if (next) {
    const output = document.querySelector('#next-description');
    const nextLink = Object.assign(document.createElement('a'), { href: next.url, textContent: next.title });
    output.replaceChildren('下一项待验收：', nextLink);
  } else {
    const output = document.querySelector('#next-description');
    const reviewLink = Object.assign(document.createElement('a'), { href: new URL('records/#reflection', location.href).href, textContent: '复盘一次独立交付' });
    output.replaceChildren('这一段已通过验收，可以', reviewLink, '。');
  }
}
const passed = unit.filter(x => data.records[x.id]?.status === 'passed').length;
document.querySelector('#evidence-count').textContent = passed + ' / ' + unit.length + ' 通过验收';
if (data.profile.weeklyFocus.trim()) {
  document.querySelector('#focus-text').textContent = data.profile.weeklyFocus;
  document.querySelector('#weekly-plan').hidden = false;
}
const review = unit.filter(x => data.records[x.id]?.review);
if (review.length) {
  const output = document.querySelector('#review-queue');
  output.hidden = false;
  output.replaceChildren('待复习：');
  for (const [i, item] of review.entries()) {
    if (i) output.append(' · ');
    output.append(Object.assign(document.createElement('a'), { href: item.url + '#practice-record', textContent: item.title }));
  }
}
</script>
